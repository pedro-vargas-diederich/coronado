# ==============================================================================
# VARIABLES DE ENTORNO - DISTRIBUIDORA CORONADO
# ==============================================================================

# Entorno de Ejecución (production para Railway / development para local)
NODE_ENV=production

# Puerto del Servidor Web (Railway inyecta $PORT automáticamente; por defecto 3000)
PORT=3000

# Interfaz de escucha (0.0.0.0 requerida para contenedores y proxy inverso)
HOST=0.0.0.0

# Clave Secreta para Cifrado de Sesiones de Express
# IMPORTANTE: Reemplazar con una cadena aleatoria y segura de al menos 32 caracteres
SESSION_SECRET=cambia_esta_clave_por_un_hash_aleatorio_y_seguro_en_produccion

# ==============================================================================
# CONEXIÓN A BASE DE DATOS MYSQL (RAILWAY PRODUCCIÓN)
# ==============================================================================
# Al agregar el plugin o servicio de MySQL en Railway, esta variable se genera
# e inyecta de forma automática con formato: mysql://usuario:clave@host:puerto/railway
MYSQL_URL=mysql://root:password@containers-us-west-xxx.railway.app:3306/railway

# ==============================================================================
# CONEXIÓN A BASE DE DATOS MYSQL (DESARROLLO LOCAL XAMPP / ALTERNATIVA)
# ==============================================================================
# Se utilizan únicamente si MYSQL_URL no se encuentra definida en el entorno
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coronado_distribuidora_db
