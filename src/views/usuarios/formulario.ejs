<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Nuevo Usuario del Sistema</h1>
      <p class="text-sm text-slate-500 font-medium">Asignación de credenciales, nivel de permisos y comisiones</p>
    </div>
    <a href="/usuarios" class="inline-flex items-center space-x-1 text-sm font-semibold text-slate-600 hover:text-slate-900">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Volver</span>
    </a>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-sm">
    <form action="<%= accion %>" method="POST" id="form-usuario" class="space-y-6">
      
      <!-- Nombre Completo -->
      <div>
        <label for="nombre" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Nombre Completo y Apellidos *
        </label>
        <input 
          type="text" 
          id="nombre" 
          name="nombre" 
          required 
          placeholder="Ej. Juan Sebastián Morales" 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <!-- Correo Electrónico -->
      <div>
        <label for="correo" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Correo Electrónico Corporativo *
        </label>
        <input 
          type="email" 
          id="correo" 
          name="correo" 
          required 
          placeholder="ejemplo@distribuidora.com" 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <!-- Contraseña Temporal -->
      <div>
        <label for="clave" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Contraseña Inicial / Temporal *
        </label>
        <input 
          type="password" 
          id="clave" 
          name="clave" 
          required 
          placeholder="••••••••••••" 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
        <p class="text-xs text-slate-400 mt-1">Se cifrará de manera segura con algoritmo bcrypt antes de guardarse.</p>
      </div>

      <!-- Rol Asignado -->
      <div>
        <label for="rol" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Rol de Acceso en el Sistema *
        </label>
        <select 
          id="rol" 
          name="rol" 
          required 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
          <option value="">Seleccione un rol...</option>
          <option value="VENDEDOR">VENDEDOR (Cotizador en vivo, clientes propios y sus comisiones)</option>
          <option value="ADMINISTRADOR">ADMINISTRADOR (Operaciones, inventario, flota y gastos)</option>
          <option value="SOCIO">SOCIO DIRECTIVO (Dashboard directivo, balance financiero y usuarios)</option>
        </select>
      </div>

      <!-- Porcentaje de Comisión (Condicional para VENDEDOR) -->
      <div id="contenedor-comision" class="p-4 rounded-xl border border-slate-200 bg-slate-50 transition space-y-2 hidden">
        <div class="flex items-center justify-between">
          <label for="porcentaje_comision" class="block text-xs font-bold uppercase tracking-wider text-slate-800">
            Porcentaje de Comisión (%) <span class="text-amber-700 font-extrabold">* Obligatorio para Vendedor</span>
          </label>
          <span class="text-[11px] text-slate-500 font-medium">Liquidación sobre Ventas</span>
        </div>

        <input 
          type="number" 
          step="0.01" 
          min="0" 
          max="100" 
          id="porcentaje_comision" 
          name="porcentaje_comision" 
          placeholder="Ej. 3.50" 
          class="w-full h-14 px-4 bg-white border border-slate-300 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none text-base"
        >

        <p class="text-xs text-slate-500">
          Este porcentaje se aplicará automáticamente a cada venta formalizada que el asesor concrete.
        </p>
      </div>

      <!-- Botones de Acción -->
      <div class="pt-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <a href="/usuarios" class="h-14 px-6 inline-flex items-center justify-center rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition">
          Cancelar
        </a>
        <button type="submit" class="h-14 px-8 inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition">
          Crear Usuario
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const rolSelect = document.getElementById('rol');
  const comisionContainer = document.getElementById('contenedor-comision');
  const comisionInput = document.getElementById('porcentaje_comision');

  function toggleComisionField() {
    if (rolSelect.value === 'VENDEDOR') {
      comisionContainer.classList.remove('hidden');
      comisionInput.required = true;
      if (!comisionInput.value) {
        comisionInput.value = '3.00';
      }
    } else {
      comisionContainer.classList.add('hidden');
      comisionInput.required = false;
      comisionInput.value = '';
    }
  }

  rolSelect.addEventListener('change', toggleComisionField);
  toggleComisionField();
</script>
