<div class="max-w-2xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
        <%= contacto ? 'Editar Contacto' : (userRole === 'VENDEDOR' ? 'Nuevo Cliente' : 'Nuevo Contacto') %>
      </h1>
      <p class="text-sm text-slate-500 font-medium">Información fiscal y condiciones de cartera</p>
    </div>
    <a href="/contactos" class="inline-flex items-center space-x-1 text-sm font-semibold text-slate-600 hover:text-slate-900">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Volver</span>
    </a>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-sm">
    <form action="<%= accion %>" method="POST" class="space-y-6">
      
      <% if (userRole !== 'VENDEDOR') { %>
        <!-- Tipo de Contacto -->
        <div>
          <label for="tipo" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
            Tipo de Contacto *
          </label>
          <select 
            id="tipo" 
            name="tipo" 
            required
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
            <option value="CLIENTE" <%= contacto && contacto.tipo === 'CLIENTE' ? 'selected' : '' %>>CLIENTE</option>
            <option value="PROVEEDOR" <%= contacto && contacto.tipo === 'PROVEEDOR' ? 'selected' : '' %>>PROVEEDOR</option>
            <option value="AMBOS" <%= contacto && contacto.tipo === 'AMBOS' ? 'selected' : '' %>>AMBOS (Cliente y Proveedor)</option>
          </select>
        </div>
      <% } else { %>
        <input type="hidden" name="tipo" value="CLIENTE">
      <% } %>

      <!-- Razón Social -->
      <div>
        <label for="razon_social" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Razón Social / Nombre Comercial *
        </label>
        <input 
          type="text" 
          id="razon_social" 
          name="razon_social" 
          required 
          placeholder="Ej. Constructora Los Andes S.A.S."
          value="<%= contacto ? contacto.razon_social : '' %>"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <!-- NIT / Identificación Fiscal -->
      <div>
        <label for="identificacion_fiscal" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Identificación Fiscal (NIT / RUC / Cédula) *
        </label>
        <input 
          type="text" 
          id="identificacion_fiscal" 
          name="identificacion_fiscal" 
          required 
          placeholder="Ej. NIT 901.458.789-2"
          value="<%= contacto ? contacto.identificacion_fiscal : '' %>"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Teléfono -->
        <div>
          <label for="telefono" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
            Teléfono Móvil / Fijo
          </label>
          <input 
            type="text" 
            id="telefono" 
            name="telefono" 
            placeholder="310 123 4567"
            value="<%= contacto ? contacto.telefono : '' %>"
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Correo Electrónico -->
        <div>
          <label for="correo" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
            Correo Electrónico
          </label>
          <input 
            type="email" 
            id="correo" 
            name="correo" 
            placeholder="contacto@empresa.com"
            value="<%= contacto ? contacto.correo : '' %>"
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>
      </div>

      <!-- Dirección -->
      <div>
        <label for="direccion" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Dirección de Despacho / Obra
        </label>
        <input 
          type="text" 
          id="direccion" 
          name="direccion" 
          placeholder="Calle 100 # 15-20, Entrada 2"
          value="<%= contacto ? contacto.direccion : '' %>"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <!-- Límite de Crédito -->
      <div>
        <label for="limite_credito" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Límite de Crédito Autorizado (Bs)
        </label>
        <input 
          type="number" 
          step="0.01" 
          id="limite_credito" 
          name="limite_credito" 
          placeholder="0.00"
          value="<%= contacto ? contacto.limite_credito : '0' %>"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
      </div>

      <!-- Botones -->
      <div class="pt-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <a href="/contactos" class="h-14 px-6 inline-flex items-center justify-center rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition">
          Cancelar
        </a>
        <button type="submit" class="h-14 px-8 inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition">
          <%= contacto ? 'Guardar Cambios' : 'Registrar Contacto' %>
        </button>
      </div>
    </form>
  </div>
</div>
