<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Registrar Gasto Operativo</h1>
      <p class="text-sm text-slate-500 font-medium">Imputación a centros de costo, combustible y flota vehicular</p>
    </div>
    <a href="/gastos" class="inline-flex items-center space-x-1 text-sm font-semibold text-slate-600 hover:text-slate-900">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Volver</span>
    </a>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-sm">
    <form action="/gastos/nuevo" method="POST" id="form-gasto" class="space-y-6">
      
      <!-- Categoría de Gasto -->
      <div>
        <label for="categoria" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Categoría de Egreso *
        </label>
        <select 
          id="categoria" 
          name="categoria" 
          required 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
          <option value="">Seleccione categoría...</option>
          <option value="COMBUSTIBLE">Combustible (Diesel / Gasolina) [Obliga Vehículo]</option>
          <option value="MANTENIMIENTO_VEHICULO">Mantenimiento de Vehículo [Obliga Vehículo]</option>
          <option value="ALQUILER">Alquiler de Bodega / Instalaciones</option>
          <option value="SERVICIOS_BASICOS">Servicios Básicos (Agua, Energía, Internet)</option>
          <option value="NOMINA">Nómina / Mano de Obra</option>
          <option value="OTROS">Otros Gastos Administrativos</option>
        </select>
      </div>

      <!-- Vehículo Asociado (Condicional/Obligatorio para Combustible y Mantenimiento) -->
      <div id="contenedor-vehiculo" class="p-4 rounded-xl border border-slate-200 bg-slate-50 transition space-y-2">
        <div class="flex items-center justify-between">
          <label for="vehiculo_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
            Vehículo de Flota Asignado <span id="vehiculo-required-badge" class="hidden text-rose-600 font-extrabold">* (OBLIGATORIO)</span>
          </label>
          <span class="text-[11px] text-slate-500 font-medium">Flota Coronado</span>
        </div>

        <select 
          id="vehiculo_id" 
          name="vehiculo_id" 
          class="w-full h-14 px-4 bg-white border border-slate-300 rounded-xl text-slate-900 focus:ring-2 focus:ring-slate-900 focus:outline-none text-base"
        >
          <option value="">Seleccione vehículo de la flota...</option>
          <% vehiculos.forEach(function(v) { %>
            <option value="<%= v.id %>">
              🚚 <%= v.placa %> - <%= v.modelo %> (<%= v.conductor_asignado %>)
            </option>
          <% }); %>
        </select>

        <p id="vehiculo-aviso" class="text-xs text-slate-500">
          Requerido automáticamente para imputar el gasto al centro de costo vehicular.
        </p>
      </div>

      <!-- Proveedor (Opcional) -->
      <div>
        <label for="proveedor_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Proveedor / Estación de Servicio / Taller (Opcional)
        </label>
        <select 
          id="proveedor_id" 
          name="proveedor_id" 
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
        >
          <option value="">Seleccione proveedor (si aplica)...</option>
          <% proveedores.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.razon_social %> (<%= p.identificacion_fiscal %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Monto -->
        <div>
          <label for="monto" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Monto del Gasto (Bs) *
          </label>
          <input 
            type="number" 
            step="0.01" 
            id="monto" 
            name="monto" 
            required 
            placeholder="0.00" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Fecha del Gasto -->
        <div>
          <label for="fecha_gasto" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Fecha de Ejecución *
          </label>
          <input 
            type="date" 
            id="fecha_gasto" 
            name="fecha_gasto" 
            required 
            value="<%= new Date().toISOString().split('T')[0] %>"
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Forma de Pago -->
        <div>
          <label for="metodo_pago" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Método de Pago
          </label>
          <select 
            id="metodo_pago" 
            name="metodo_pago" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
            <option value="EFECTIVO">EFECTIVO / CAJA MENOR</option>
            <option value="TRANSFERENCIA">TRANSFERENCIA BANCARIA</option>
            <option value="CREDITO">CRÉDITO PROVEEDOR</option>
          </select>
        </div>

        <!-- Número de Comprobante -->
        <div>
          <label for="numero_comprobante" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            No. Factura / Recibo
          </label>
          <input 
            type="text" 
            id="numero_comprobante" 
            name="numero_comprobante" 
            placeholder="Ej. FAC-99823"
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition uppercase"
          >
        </div>
      </div>

      <!-- Descripción -->
      <div>
        <label for="descripcion" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Detalle / Justificación del Gasto *
        </label>
        <textarea 
          id="descripcion" 
          name="descripcion" 
          rows="2" 
          required 
          placeholder="Ej. Tanqueo 40 galones Diesel para ruta de distribución a obra norte"
          class="w-full p-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-sm transition"
        ></textarea>
      </div>

      <!-- Botones de Acción -->
      <div class="pt-4 border-t border-slate-100 flex flex-col-reverse sm:flex-row sm:justify-end gap-3">
        <a href="/gastos" class="h-14 px-6 inline-flex items-center justify-center rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition">
          Cancelar
        </a>
        <button type="submit" class="h-14 px-8 inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition">
          Registrar Gasto
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const categoriaSelect = document.getElementById('categoria');
  const vehiculoSelect = document.getElementById('vehiculo_id');
  const vehiculoBadge = document.getElementById('vehiculo-required-badge');
  const contenedorVehiculo = document.getElementById('contenedor-vehiculo');
  const aviso = document.getElementById('vehiculo-aviso');

  function checkVehiculoObligatorio() {
    const cat = categoriaSelect.value;
    const esVehicular = (cat === 'COMBUSTIBLE' || cat === 'MANTENIMIENTO_VEHICULO');

    if (esVehicular) {
      vehiculoSelect.required = true;
      vehiculoBadge.classList.remove('hidden');
      contenedorVehiculo.classList.add('border-amber-400', 'bg-amber-50/50');
      aviso.textContent = '⚠️ Para este tipo de gasto es OBLIGATORIO seleccionar el vehículo.';
      aviso.className = 'text-xs text-amber-800 font-semibold';
    } else {
      vehiculoSelect.required = false;
      vehiculoBadge.classList.add('hidden');
      contenedorVehiculo.classList.remove('border-amber-400', 'bg-amber-50/50');
      aviso.textContent = 'Opcional si no corresponde a un vehículo específico.';
      aviso.className = 'text-xs text-slate-500';
    }
  }

  categoriaSelect.addEventListener('change', checkVehiculoObligatorio);
  checkVehiculoObligatorio();
</script>
