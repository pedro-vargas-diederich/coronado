<% if (currentUser) { %>
<!-- Barra de navegación fija inferior para dispositivos móviles (Mobile-First) -->
<nav id="bottom-navbar" class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-slate-200 h-16 md:hidden px-2 flex items-center justify-around shadow-lg no-print">
  
  <% if (currentUser.rol === 'VENDEDOR') { %>
    <!-- Tab 1: Mis Cotizaciones -->
    <a href="/pedidos" class="flex flex-col items-center justify-center w-full h-full py-1 <%= currentPath.startsWith('/pedidos') && !currentPath.includes('nuevo') && !currentPath.includes('comisiones') ? 'text-slate-900 font-bold' : 'text-slate-500 hover:text-slate-800' %>">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Cotizaciones</span>
    </a>

    <!-- Tab 2: Nueva Cotización (Acción destacada) -->
    <a href="/pedidos/nuevo" class="flex flex-col items-center justify-center w-full h-full py-1">
      <div class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center shadow-md -mt-3 border-2 border-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
        </svg>
      </div>
      <span class="text-[10px] font-semibold text-slate-900 mt-0.5">Cotizar</span>
    </a>

    <!-- Tab 3: Mis Clientes -->
    <a href="/contactos" class="flex flex-col items-center justify-center w-full h-full py-1 <%= currentPath.startsWith('/contactos') ? 'text-slate-900 font-bold' : 'text-slate-500 hover:text-slate-800' %>">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Clientes</span>
    </a>

    <!-- Tab 4: Menú / Comisiones -->
    <button type="button" class="toggle-mobile-drawer flex flex-col items-center justify-center w-full h-full py-1 text-slate-500 hover:text-slate-800">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Menú</span>
    </button>

  <% } else { %>
    <!-- Tab 1: Dashboard Directivo / Operativo -->
    <a href="/dashboard" class="flex flex-col items-center justify-center w-full h-full py-1 <%= currentPath === '/dashboard' ? 'text-slate-900 font-bold' : 'text-slate-500 hover:text-slate-800' %>">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Dashboard</span>
    </a>

    <!-- Tab 2: Cotizaciones y Ventas -->
    <a href="/pedidos" class="flex flex-col items-center justify-center w-full h-full py-1 <%= currentPath.startsWith('/pedidos') ? 'text-slate-900 font-bold' : 'text-slate-500 hover:text-slate-800' %>">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Pedidos</span>
    </a>

    <!-- Tab 3: Gastos -->
    <a href="/gastos" class="flex flex-col items-center justify-center w-full h-full py-1 <%= currentPath.startsWith('/gastos') ? 'text-slate-900 font-bold' : 'text-slate-500 hover:text-slate-800' %>">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Gastos</span>
    </a>

    <!-- Tab 4: Menú Más (Inventario, Flota, Contactos) -->
    <button type="button" class="toggle-mobile-drawer flex flex-col items-center justify-center w-full h-full py-1 text-slate-500 hover:text-slate-800">
      <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
      <span class="text-[10px] tracking-tight">Menú</span>
    </button>
  <% } %>

</nav>
<% } %>
