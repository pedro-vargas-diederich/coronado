<% if (success_msg && success_msg.length > 0) { %>
  <div class="mb-4 space-y-2 no-print">
    <% success_msg.forEach(function(msg) { %>
      <div class="flash-alert-item flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl shadow-sm text-sm">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 text-emerald-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium"><%= msg %></span>
        </div>
        <button type="button" class="alert-close text-emerald-700 hover:text-emerald-900 p-1 rounded-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (error_msg && error_msg.length > 0) { %>
  <div class="mb-4 space-y-2 no-print">
    <% error_msg.forEach(function(msg) { %>
      <div class="flash-alert-item flex items-center justify-between p-4 bg-rose-50 border border-rose-200 text-rose-900 rounded-xl shadow-sm text-sm">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 text-rose-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium"><%= msg %></span>
        </div>
        <button type="button" class="alert-close text-rose-700 hover:text-rose-900 p-1 rounded-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    <% }); %>
  </div>
<% } %>

<% if (info_msg && info_msg.length > 0) { %>
  <div class="mb-4 space-y-2 no-print">
    <% info_msg.forEach(function(msg) { %>
      <div class="flash-alert-item flex items-center justify-between p-4 bg-slate-100 border border-slate-300 text-slate-800 rounded-xl shadow-sm text-sm">
        <div class="flex items-center space-x-3">
          <svg class="w-5 h-5 text-slate-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-medium"><%= msg %></span>
        </div>
        <button type="button" class="alert-close text-slate-600 hover:text-slate-800 p-1 rounded-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    <% }); %>
  </div>
<% } %>
