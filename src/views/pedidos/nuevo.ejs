<div class="max-w-4xl mx-auto space-y-6">
  <!-- Cabecera -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Generar Cotización</h1>
      <p class="text-sm text-slate-500 font-medium">Cotice materiales de construcción con cálculo inmediato</p>
    </div>
    <a href="/pedidos" class="inline-flex items-center space-x-1 text-sm font-semibold text-slate-600 hover:text-slate-900">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Cancelar</span>
    </a>
  </div>

  <form id="form-cotizacion" action="/pedidos/nuevo" method="POST" class="space-y-6">
    <!-- Entrada oculta con el arreglo JSON de items -->
    <input type="hidden" name="items" id="items-json" value="[]">

    <!-- Sección 1: Datos Generales -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-2">
        1. Información del Cliente y Pago
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Cliente -->
        <div class="sm:col-span-2">
          <label for="cliente_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Cliente Destinatario *
          </label>
          <select 
            id="cliente_id" 
            name="cliente_id" 
            required 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
            <option value="">Seleccione un cliente...</option>
            <% clientes.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.razon_social %> (<%= c.identificacion_fiscal %>)</option>
            <% }); %>
          </select>
        </div>

        <!-- Método de Pago -->
        <div>
          <label for="metodo_pago" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Forma de Pago Propuesta
          </label>
          <select 
            id="metodo_pago" 
            name="metodo_pago" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
            <option value="EFECTIVO">EFECTIVO / CONTADO</option>
            <option value="TRANSFERENCIA">TRANSFERENCIA BANCARIA</option>
            <option value="CREDITO">CRÉDITO COMERCIAL</option>
          </select>
        </div>

        <!-- Fecha Vencimiento Cotización -->
        <div>
          <label for="fecha_vencimiento" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Vigencia de la Cotización
          </label>
          <input 
            type="date" 
            id="fecha_vencimiento" 
            name="fecha_vencimiento" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Asignación de Vendedor (Solo para Admin o Socio) -->
        <% if (currentUser.rol !== 'VENDEDOR') { %>
          <div class="sm:col-span-2">
            <label for="vendedor_id" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Asignar a Asesor Comercial (Opcional)
            </label>
            <select 
              id="vendedor_id" 
              name="vendedor_id" 
              class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
            >
              <% vendedores.forEach(function(v) { %>
                <option value="<%= v.id %>"><%= v.nombre %></option>
              <% }); %>
            </select>
          </div>
        <% } %>

        <!-- Observaciones -->
        <div class="sm:col-span-2">
          <label for="observaciones" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Observaciones o Condiciones de Entrega
          </label>
          <textarea 
            id="observaciones" 
            name="observaciones" 
            rows="2" 
            placeholder="Ej. Precios incluyen descargue en pie de obra. Validez por 15 días."
            class="w-full p-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-sm transition"
          ></textarea>
        </div>
      </div>
    </div>

    <!-- Sección 2: Selector de Materiales (Líneas de Pedido) -->
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm space-y-4">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-2">
        2. Agregar Materiales a la Cotización
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
        <!-- Selector de Producto -->
        <div class="sm:col-span-6">
          <label for="select-producto" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Material / Producto
          </label>
          <select 
            id="select-producto" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
            <option value="">Seleccione material...</option>
            <% productos.forEach(function(p) { %>
              <option 
                value="<%= p.id %>" 
                data-precio="<%= p.precio_venta %>" 
                data-stock="<%= p.existencia %>"
                data-unidad="<%= p.unidad_medida %>"
                data-nombre="<%= p.nombre %>"
                data-sku="<%= p.codigo_sku %>"
              >
                <%= p.nombre %> (Stock: <%= Number(p.existencia).toFixed(1) %> <%= p.unidad_medida %>) - <%= formatMoney(p.precio_venta) %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Cantidad -->
        <div class="sm:col-span-3">
          <label for="input-cantidad" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Cantidad
          </label>
          <input 
            type="number" 
            step="0.01" 
            min="0.01" 
            id="input-cantidad" 
            placeholder="0" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Precio Unitario -->
        <div class="sm:col-span-3">
          <label for="input-precio" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
            Precio Unit. (Bs)
          </label>
          <input 
            type="number" 
            step="0.01" 
            id="input-precio" 
            placeholder="0.00" 
            class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-900 focus:outline-none text-base transition"
          >
        </div>

        <!-- Botón Añadir -->
        <div class="sm:col-span-12">
          <button 
            type="button" 
            id="btn-agregar-item" 
            class="w-full h-12 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded-xl border border-slate-300 flex items-center justify-center space-x-2 transition text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Añadir Material a la Lista</span>
          </button>
        </div>
      </div>

      <!-- Lista / Tabla de Materiales Agregados -->
      <div class="pt-4 border-t border-slate-100">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Materiales en la Cotización</p>
        
        <div id="contenedor-items-vacio" class="p-8 text-center text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-300 text-sm">
          Aún no has agregado materiales. Selecciona un producto arriba y pulsa "Añadir".
        </div>

        <!-- Tabla dinámica (escritorio y móvil) -->
        <div id="contenedor-tabla-items" class="hidden overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-slate-200 text-xs font-bold text-slate-600 uppercase">
                <th class="py-2.5 px-3">Descripción</th>
                <th class="py-2.5 px-3 text-right">Cant.</th>
                <th class="py-2.5 px-3 text-right">Precio Unit. (Bs)</th>
                <th class="py-2.5 px-3 text-right">Total (Bs)</th>
                <th class="py-2.5 px-3 text-center">Quitar</th>
              </tr>
            </thead>
            <tbody id="tabla-items-body" class="divide-y divide-slate-100">
              <!-- Renderizado dinámicamente con JS -->
            </tbody>
          </table>
        </div>

        <!-- Total General en Vivo -->
        <div class="mt-4 pt-4 border-t border-slate-200 flex justify-between items-center px-2">
          <span class="text-base font-bold text-slate-900">Total Cotización:</span>
          <span id="label-total-general" class="text-2xl font-black text-slate-900">Bs 0.00</span>
        </div>
      </div>
    </div>

    <!-- Botones de Acción Final -->
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-2">
      <a href="/pedidos" class="h-14 px-6 inline-flex items-center justify-center rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition">
        Cancelar
      </a>
      <button 
        type="submit" 
        id="btn-guardar-cotizacion" 
        class="h-14 px-8 inline-flex items-center justify-center rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-base shadow-md hover:shadow-lg transition space-x-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span>Guardar y Generar Cotización</span>
      </button>
    </div>
  </form>
</div>

<script>
  // Manejo reactivo de las líneas de la cotización
  const items = [];
  const selectProducto = document.getElementById('select-producto');
  const inputCantidad = document.getElementById('input-cantidad');
  const inputPrecio = document.getElementById('input-precio');
  const btnAgregar = document.getElementById('btn-agregar-item');
  const itemsJsonInput = document.getElementById('items-json');
  const tablaBody = document.getElementById('tabla-items-body');
  const contenedorVacio = document.getElementById('contenedor-items-vacio');
  const contenedorTabla = document.getElementById('contenedor-tabla-items');
  const labelTotal = document.getElementById('label-total-general');
  const formCotizacion = document.getElementById('form-cotizacion');

  // Autocompletar precio de venta al seleccionar producto
  selectProducto.addEventListener('change', () => {
    const selectedOption = selectProducto.options[selectProducto.selectedIndex];
    if (selectedOption && selectedOption.dataset.precio) {
      inputPrecio.value = parseFloat(selectedOption.dataset.precio).toFixed(2);
      inputCantidad.focus();
    } else {
      inputPrecio.value = '';
    }
  });

  // Función para formatear dinero en Bolivianos (Bs)
  function formatMoney(num) {
    const n = parseFloat(num) || 0;
    const partes = Math.abs(n).toFixed(2).split('.');
    partes[0] = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    return `${n < 0 ? '-' : ''}Bs ${partes.join('.')}`;
  }

  // Renderizar la tabla de líneas
  function renderItems() {
    tablaBody.innerHTML = '';
    let totalGeneral = 0;

    if (items.length === 0) {
      contenedorVacio.classList.remove('hidden');
      contenedorTabla.classList.add('hidden');
      labelTotal.textContent = 'Bs 0.00';
      itemsJsonInput.value = '[]';
      return;
    }

    contenedorVacio.classList.add('hidden');
    contenedorTabla.classList.remove('hidden');

    items.forEach((item, index) => {
      const subtotalLinea = item.cantidad * item.precio_unitario;
      totalGeneral += subtotalLinea;

      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-50/70 transition';
      tr.innerHTML = `
        <td class="py-3 px-3">
          <p class="font-bold text-slate-900">${item.nombre}</p>
          <p class="text-xs text-slate-500 font-mono">SKU: ${item.sku} | ${item.unidad}</p>
        </td>
        <td class="py-3 px-3 text-right font-semibold text-slate-900">${item.cantidad.toFixed(2)}</td>
        <td class="py-3 px-3 text-right text-slate-700">${formatMoney(item.precio_unitario)}</td>
        <td class="py-3 px-3 text-right font-bold text-slate-900">${formatMoney(subtotalLinea)}</td>
        <td class="py-3 px-3 text-center">
          <button type="button" onclick="eliminarItem(${index})" class="text-rose-600 hover:text-rose-800 p-1.5 rounded-lg hover:bg-rose-50 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </td>
      `;
      tablaBody.appendChild(tr);
    });

    labelTotal.textContent = formatMoney(totalGeneral);
    itemsJsonInput.value = JSON.stringify(items);
  }

  // Agregar nuevo item a la lista
  btnAgregar.addEventListener('click', () => {
    const selectedOption = selectProducto.options[selectProducto.selectedIndex];
    if (!selectedOption || !selectedOption.value) {
      alert('Por favor selecciona un material.');
      return;
    }

    const cantidad = parseFloat(inputCantidad.value);
    const precio = parseFloat(inputPrecio.value);

    if (isNaN(cantidad) || cantidad <= 0) {
      alert('Ingresa una cantidad válida mayor a 0.');
      inputCantidad.focus();
      return;
    }

    if (isNaN(precio) || precio <= 0) {
      alert('Ingresa un precio unitario válido mayor a 0.');
      inputPrecio.focus();
      return;
    }

    // Verificar si ya existe en la lista para acumular cantidad
    const existente = items.find(i => i.producto_id === selectedOption.value);
    if (existente) {
      existente.cantidad += cantidad;
      existente.precio_unitario = precio;
    } else {
      items.push({
        producto_id: selectedOption.value,
        nombre: selectedOption.dataset.nombre,
        sku: selectedOption.dataset.sku,
        unidad: selectedOption.dataset.unidad,
        cantidad: cantidad,
        precio_unitario: precio
      });
    }

    // Limpiar campos
    selectProducto.selectedIndex = 0;
    inputCantidad.value = '';
    inputPrecio.value = '';
    renderItems();
  });

  window.eliminarItem = function(index) {
    items.splice(index, 1);
    renderItems();
  };

  // Validación final antes de enviar
  formCotizacion.addEventListener('submit', (e) => {
    if (items.length === 0) {
      e.preventDefault();
      alert('Debes agregar al menos un material antes de guardar la cotización.');
    }
  });
</script>
