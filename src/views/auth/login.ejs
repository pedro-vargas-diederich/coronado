<div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-xl">
  <!-- Cabecera de Login -->
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-slate-900 text-white font-extrabold text-2xl mb-4 shadow-md">
      C
    </div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Distribuidora Coronado</h1>
    <p class="text-sm text-slate-500 mt-1 font-medium">Control Administrativo & Financiero</p>
  </div>

  <!-- Formulario de Acceso -->
  <form action="/login" method="POST" class="space-y-5">
    <div>
      <label for="correo" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
        Correo Corporativo
      </label>
      <div class="relative">
        <input 
          type="email" 
          id="correo" 
          name="correo" 
          required 
          placeholder="ejemplo@distribuidora.com"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent text-base transition"
        >
      </div>
    </div>

    <div>
      <label for="clave" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
        Contraseña
      </label>
      <div class="relative">
        <input 
          type="password" 
          id="clave" 
          name="clave" 
          required 
          placeholder="••••••••••••"
          class="w-full h-14 px-4 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent text-base transition"
        >
      </div>
    </div>

    <button 
      type="submit" 
      class="w-full h-14 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center space-x-2 text-base"
    >
      <span>Ingresar al Sistema</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </button>
  </form>

  <!-- Panel de Credenciales Rápidas para Pruebas de Roles -->
  <div class="mt-8 pt-6 border-t border-slate-100">
    <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 text-center">
      Credenciales Predefinidas para Prueba
    </p>
    <div class="space-y-2">
      <button 
        type="button" 
        onclick="fillCredentials('socio@distribuidora.com', 'Socio123!')" 
        class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition flex items-center justify-between"
      >
        <div>
          <p class="text-xs font-bold text-slate-900">Socio Directivo (Balance & Utilidad)</p>
          <p class="text-[11px] text-slate-500">socio@distribuidora.com</p>
        </div>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-100 text-purple-800">SOCIO</span>
      </button>

      <button 
        type="button" 
        onclick="fillCredentials('admin@distribuidora.com', 'Admin123!')" 
        class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition flex items-center justify-between"
      >
        <div>
          <p class="text-xs font-bold text-slate-900">Administrador (Inventario & Gastos)</p>
          <p class="text-[11px] text-slate-500">admin@distribuidora.com</p>
        </div>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">ADMIN</span>
      </button>

      <button 
        type="button" 
        onclick="fillCredentials('vendedor@distribuidora.com', 'Vendedor123!')" 
        class="w-full text-left p-3 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition flex items-center justify-between"
      >
        <div>
          <p class="text-xs font-bold text-slate-900">Asesor Comercial (Cotizaciones)</p>
          <p class="text-[11px] text-slate-500">vendedor@distribuidora.com</p>
        </div>
        <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">VENDEDOR</span>
      </button>
    </div>
  </div>
</div>

<script>
  function fillCredentials(email, pass) {
    document.getElementById('correo').value = email;
    document.getElementById('clave').value = pass;
  }
</script>
