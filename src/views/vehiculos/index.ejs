<div class="space-y-6">
  <!-- Cabecera de Página -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Flota de Vehículos</h1>
      <p class="text-sm text-slate-500 font-medium">Gestión de camiones de carga, conductores y centros de costo</p>
    </div>
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
      <a href="/vehiculos/mapa" class="inline-flex items-center justify-center space-x-2 h-12 px-5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-sm font-bold rounded-xl shadow-sm transition">
        <span>🗺️</span>
        <span>Mapa GPS en Vivo</span>
      </a>
      <a href="/vehiculos/nuevo" class="inline-flex items-center justify-center space-x-2 h-12 px-5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold rounded-xl shadow-sm transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Nueva Unidad</span>
      </a>
    </div>
  </div>

  <!-- Tarjetas de Resumen Rápido de Flota -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Unidades en Servicio</span>
      <div class="flex items-baseline space-x-2">
        <p class="text-3xl font-black text-slate-900"><%= totalUnidadesActivas %></p>
        <span class="text-xs text-slate-400 font-medium">de <%= vehiculos.length %> registradas</span>
      </div>
      <p class="text-xs text-slate-500">Capacidad logística operativa</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-1">
      <span class="text-xs font-bold uppercase tracking-wider text-rose-700">Gastos Históricos Acumulados</span>
      <p class="text-3xl font-black text-slate-900"><%= formatMoney(totalGastosFlota) %></p>
      <p class="text-xs text-slate-500">Combustible y mantenimientos asignados</p>
    </div>
  </div>

  <!-- Vista Móvil: Tarjetas (block md:hidden) -->
  <div class="grid grid-cols-1 gap-3 md:hidden">
    <% if (vehiculos.length === 0) { %>
      <div class="p-8 text-center bg-white rounded-2xl border border-slate-200 text-slate-500 text-sm">
        No hay vehículos registrados en la flota.
      </div>
    <% } %>

    <% vehiculos.forEach(function(item) { %>
      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-lg">
              🚚
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <span class="font-mono font-black text-slate-900 text-base tracking-wider"><%= item.placa %></span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border <%= item.activo ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200' %>">
                  <%= item.activo ? 'ACTIVO' : 'FUERA DE SERVICIO' %>
                </span>
              </div>
              <p class="text-xs text-slate-500 font-medium mt-0.5"><%= item.modelo %></p>
            </div>
          </div>
          <a href="/vehiculos/<%= item.id %>/editar" class="p-2 text-slate-400 hover:text-slate-800 rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
          </a>
        </div>

        <div class="pt-2 border-t border-slate-100 text-xs text-slate-600 space-y-1.5">
          <div class="flex justify-between items-center">
            <span class="text-slate-500">Conductor Asignado:</span>
            <span class="font-bold text-slate-800"><%= item.conductor_asignado %></span>
          </div>

          <div class="flex justify-between items-center">
            <span class="text-slate-500">Egresos Totales Imputados:</span>
            <span class="font-black text-rose-700 text-sm">
              <%= formatMoney(item.total_gastos_acumulados) %>
            </span>
          </div>

          <div class="flex justify-between items-center text-[11px] text-slate-400">
            <span>Registros de Gasto: <%= item.total_registros_gastos %></span>
            <span>Desde: <%= formatDate(item.creado_en) %></span>
          </div>
        </div>

        <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2">
          <a href="/vehiculos/<%= item.id %>/gps-tracker" target="_blank" class="h-10 px-3.5 inline-flex items-center space-x-1.5 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-xl transition">
            <span>📡</span>
            <span>Tablet GPS</span>
          </a>

          <a href="/vehiculos/<%= item.id %>/editar" class="h-10 px-4 inline-flex items-center space-x-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <span>Editar</span>
          </a>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Vista Escritorio: Tabla (hidden md:table) -->
  <div class="hidden md:block bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase tracking-wider">
            <th class="py-3.5 px-4">Placa</th>
            <th class="py-3.5 px-4">Modelo / Especificación</th>
            <th class="py-3.5 px-4">Conductor Asignado</th>
            <th class="py-3.5 px-4 text-center">Estado Operativo</th>
            <th class="py-3.5 px-4 text-right">Gastos Acumulados</th>
            <th class="py-3.5 px-4 text-center">No. Gastos</th>
            <th class="py-3.5 px-4 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (vehiculos.length === 0) { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-500">No hay vehículos registrados en la flota.</td>
            </tr>
          <% } %>

          <% vehiculos.forEach(function(item) { %>
            <tr class="hover:bg-slate-50/60 transition">
              <td class="py-3.5 px-4">
                <span class="font-mono font-black text-slate-900 tracking-wider"><%= item.placa %></span>
              </td>
              <td class="py-3.5 px-4 font-semibold text-slate-800"><%= item.modelo %></td>
              <td class="py-3.5 px-4 text-slate-700"><%= item.conductor_asignado %></td>
              <td class="py-3.5 px-4 text-center">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold <%= item.activo ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-600 border border-slate-200' %>">
                  <%= item.activo ? 'ACTIVO' : 'INACTIVO' %>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right font-black text-rose-700 whitespace-nowrap">
                <%= formatMoney(item.total_gastos_acumulados) %>
              </td>
              <td class="py-3.5 px-4 text-center text-slate-500 font-medium">
                <%= item.total_registros_gastos %>
              </td>
              <td class="py-3.5 px-4 text-center">
                <div class="inline-flex items-center space-x-2">
                  <a href="/vehiculos/<%= item.id %>/gps-tracker" target="_blank" class="inline-flex items-center space-x-1 text-emerald-700 hover:text-emerald-900 font-bold text-xs px-2.5 py-1 rounded bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition" title="Abrir emisor en tablet">
                    <span>📡</span>
                    <span>Tablet GPS</span>
                  </a>
                  <a href="/vehiculos/<%= item.id %>/editar" class="text-slate-600 hover:text-slate-900 font-semibold text-xs px-2.5 py-1 rounded hover:bg-slate-100 transition">
                    Editar
                  </a>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
